# ==========================================
# VitoStoreApp — Variables de entorno (dart-define)
# ==========================================
# Equivalente a las variables VITE_* de la web (sección 12 del plan).
# Uso:
#   flutter run --dart-define=API_URL=http://10.0.2.2:3001 \
#     --dart-define=STRIPE_PUBLIC_KEY=pk_test_...
#
# Para producción, configura estas variables en tu CI/CD o script de build.
#
# Importante para Docker:
# - Android emulator: http://10.0.2.2:3001
# - iOS Simulator / desktop: http://localhost:3001
# - dispositivo físico: usa la IP del host (ej. http://192.168.1.50:3001)

# URL base del backend (sin /api)
API_URL=http://10.0.2.2:3001

# Clave pública de Stripe (pk_live_* o pk_test_*)
STRIPE_PUBLIC_KEY=

# Site key de reCAPTCHA (opcional, si se usa en formularios)
RECAPTCHA_SITE_KEY=

# Idioma por defecto (es | en)
APP_LANGUAGE_DEFAULT=es

# Esquema de deep links
DEEP_LINK_SCHEME=vitoapp
